apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ hostvars[inventory_hostname]['ansible_host'] }}"
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///var/run/containerd/containerd.sock
  imagePullPolicy: IfNotPresent
  name: "{{ inventory_hostname }}"
skipPhases:
  - addon/kube-proxy  
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: kubernetes
kubernetesVersion: "v1.34.12"
controlPlaneEndpoint: "{{ loadbalancer_vip }}:{{ loadbalancer_port }}"
networking:
  podSubnet: "{{ configure_k8s_pod_cidr | default('10.244.0.0/16') }}"
  serviceSubnet: "{{ configure_k8s_service_cidr | default('10.96.0.0/12') }}"
apiServer:
  certSANs:
    - "{{ loadbalancer_vip }}"
{% for host in groups['masters'] %}
    - "{{ hostvars[host]['ansible_host'] }}"
    - "{{ host }}"
{% endfor %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
