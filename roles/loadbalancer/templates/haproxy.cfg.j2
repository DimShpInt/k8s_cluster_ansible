global
        log /dev/log    local0
        log /dev/log    local1 notice
        chroot /var/lib/haproxy
        stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
        stats timeout 30s
        user haproxy
        group haproxy
        daemon

defaults
        log     global
        mode    tcp
        option  tcplog
        option  dontlognull
        retries 3
        timeout connect 5s
        timeout client  50s
        timeout server  50s

# Front VIP (port 6443)
frontend k8s-api-frontend
    bind *:{{ loadbalancer_port }}
    mode tcp
    default_backend k8s-api-backend

# Back
backend k8s-api-backend
    mode tcp
    balance roundrobin
    option tcp-check
    default-server inter 2s fastinter 1s downinter 1s fall 2 rise 1
{% for host in groups['masters'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:6443 check
{% endfor %}

# --- HTTPS: Ingress ---
frontend k8s-https-frontend
    bind *:443
    mode tcp
    default_backend k8s-https-backend

backend k8s-https-backend
    mode tcp
    balance roundrobin
    option tcp-check
    default-server inter 2s fastinter 1s downinter 1s fall 2 rise 1
{% for host in groups['masters'] + groups['workers'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ ingress_https_node_port }} check
{% endfor %}

# --- HTTP: Ingress ---
frontend k8s-http-frontend
    bind *:80
    mode tcp
    default_backend k8s-http-backend

backend k8s-http-backend
    mode tcp
    balance roundrobin
    option tcp-check
    default-server inter 2s fastinter 1s downinter 1s fall 2 rise 1
{% for host in groups['masters'] + groups['workers'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ ingress_http_node_port }} check
{% endfor %}